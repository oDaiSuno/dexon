index 0000000..26bbc7d
--- /dev/null
+++ b/tests/dom/zz-issue57-poc.test.mjs
@@ -0,0 +1,156 @@
+import assert from "node:assert/strict";
+import test, { after } from "node:test";
+import { startNavigation, control, roles, click, act, input, keyDown, waitFor, dom, restoreGlobals } from "../support/app-navigation.mjs";
+import { projectOrder, projectItem, projectMenu, unavailableAction } from "../support/app-navigation-projects.mjs";
+import { navigationPaths as P } from "../fixtures/app-navigation-data.mjs";
+import { accessibleName } from "../support/dom-queries.mjs";
+
+after(restoreGlobals);
+const saved = { openProjects: [P.personal, P.project, P.empty], lastSpaceCwd: P.project };
+const menus = () => roles(dom.window.document.body, "menu");
+const expanded = (scene) => Object.fromEntries(projectOrder(scene).map((n) => [n, control(projectItem(scene, n), "button", n).getAttribute("aria-expanded")]));
+
+test("P1 every non-default row opens the same row menu, current included; default row has no ⋯", async (t) => {
+  const scene = await startNavigation(t, saved);
+  await waitFor(() => assert.equal(projectOrder(scene).length, 3));
+  assert.equal(roles(projectItem(scene, "Default space"), "button", "Actions for Default space").length, 0);
+  for (const name of ["navigation-project", "empty-project"]) {
+    const m = await projectMenu(scene, name);
+    assert.deepEqual(roles(m, "menuitem").map(accessibleName), ["Move up", "Move down", "Close project"]);
+    await keyDown(m, "Escape");
+    await waitFor(() => assert.equal(menus().length, 0));
+  }
+});
+
+test("P2 running current project: Close project is greyed in its row menu", async (t) => {
+  const scene = await startNavigation(t, { ...saved, runningSessionIds: ["project-history"] });
+  await waitFor(() => assert.equal(projectOrder(scene).length, 3));
+  unavailableAction(await projectMenu(scene, "navigation-project"), "Close project");
+});
+
+test("P3 + opens exactly one switcher card, without Close project; search finds other projects", async (t) => {
+  const scene = await startNavigation(t, saved);
+  await waitFor(() => assert.equal(projectOrder(scene).length, 3));
+  const plus = control(scene.history(), "button", "Switch or add project");
+  await click(plus);
+  await waitFor(() => assert.equal(menus().length, 1));
+  assert.equal(plus.getAttribute("aria-expanded"), "true");
+  const card = menus()[0];
+  assert.deepEqual(roles(card, "menuitem").map(accessibleName), ["Add project space from folder…", "Back to default space"]);
+  await input(control(card, "searchbox", "Search or open a project…"), "empty");
+  await waitFor(() => assert.deepEqual(roles(card, "menuitem").map(accessibleName)[0], "empty-project"));
+});
+
+test("P4 ⌘P opens one card, sidebar open or collapsed", async (t) => {
+  const scene = await startNavigation(t, saved);
+  await waitFor(() => assert.equal(projectOrder(scene).length, 3));
+  await scene.settled();
+  await act(async () => scene.external.menu("open-project-switcher"));
+  await waitFor(() => assert.equal(menus().length, 1));
+  await keyDown(menus()[0], "Escape");
+  await waitFor(() => assert.equal(menus().length, 0));
+  await click(control(scene.navigation(), "button", "Hide sidebar"));
+  await waitFor(() => control(scene.navigation(), "button", "Show sidebar"));
+  await act(async () => scene.external.menu("open-project-switcher"));
+  await waitFor(() => assert.equal(menus().length, 1));
+  control(menus()[0], "searchbox", "Search or open a project…");
+});
+
+test("P5 card → add from folder still asks the system picker directly", async (t) => {
+  const scene = await startNavigation(t, saved);
+  await waitFor(() => assert.equal(projectOrder(scene).length, 3));
+  scene.external.desktop.selectedDirectory = null;
+  await click(control(scene.history(), "button", "Switch or add project"));
+  await click(await waitFor(() => control(menus()[0], "menuitem", "Add project space from folder…")));
+  await waitFor(() => assert.equal(scene.external.desktop.directoryRequests, 1));
+});
+
+test("P6 collapse all / expand current follows the real state, including the default-open current project", async (t) => {
+  const scene = await startNavigation(t, saved);
+  await waitFor(() => assert.equal(projectOrder(scene).length, 3));
+  const before = expanded(scene);
+  console.log("P6 initial", JSON.stringify(before));
+  await click(control(scene.history(), "button", "Collapse all projects"));
+  console.log("P6 after collapse", JSON.stringify(expanded(scene)));
+  assert.ok(Object.values(expanded(scene)).every((v) => v === "false"));
+  await click(control(scene.history(), "button", "Expand current project"));
+  console.log("P6 after expand", JSON.stringify(expanded(scene)));
+  assert.deepEqual(expanded(scene), { "Default space": "false", "navigation-project": "true", "empty-project": "false" });
+  await click(control(projectItem(scene, "navigation-project"), "button", "navigation-project"));
+  control(scene.history(), "button", "Expand current project");
+  await click(control(projectItem(scene, "empty-project"), "button", "empty-project"));
+  control(scene.history(), "button", "Collapse all projects");
+  assert.equal(await scene.currentFolder(), P.project);
+  assert.deepEqual(projectOrder(scene), ["Default space", "navigation-project", "empty-project"]);
+});
+
+test("P7 Chinese labels", async (t) => {
+  const scene = await startNavigation(t, { ...saved, language: "zh-CN" });
+  await waitFor(() => assert.equal(projectOrder(scene).length, 3));
+  control(scene.history(), "button", "切换或新增项目");
+  control(scene.history(), "button", "收起全部项目");
+});
+
+test("P8 after collapse all, switching to another project via the card", async (t) => {
+  const scene = await startNavigation(t, saved);
+  await waitFor(() => assert.equal(projectOrder(scene).length, 3));
+  await click(control(scene.projectsHeader?.() ?? scene.history(), "button", "Collapse all projects"));
+  const card = await scene.menu("navigation-project");
+  const search = control(card, "searchbox", "Search or open a project…");
+  await input(search, "empty-project");
+  await waitFor(() => assert.equal(accessibleName(roles(card, "menuitem")[0]), "empty-project"));
+  await keyDown(search, "Enter");
+  await waitFor(async () => assert.equal(await scene.currentFolder(), P.empty));
+  console.log("P8 after switch", JSON.stringify(expanded(scene)), "button:", roles(scene.history(), "button").map(accessibleName).filter((n) => /projects?$/.test(n) && /Collapse|Expand/.test(n)).join());
+  await click(control(scene.history(), "button", /Collapse all projects|Expand current project/));
+  console.log("P8 after header click", JSON.stringify(expanded(scene)));
+});
+
+test("P9 searching makes the fold button unusable; clearing restores it", async (t) => {
+  const scene = await startNavigation(t, saved);
+  await waitFor(() => assert.equal(projectOrder(scene).length, 3));
+  const box = control(scene.navigation(), "searchbox", "Search sessions");
+  await input(box, "notes");
+  await scene.settled();
+  const b = roles(scene.history(), "button").find((e) => /Collapse all projects|Expand current project/.test(accessibleName(e)));
+  console.log("P9 searching:", b && accessibleName(b), "disabled=", b?.disabled, JSON.stringify(expanded(scene)));
+  assert.equal(b.disabled, true);
+  await input(box, "");
+  await scene.settled();
+  const after = control(scene.history(), "button", "Collapse all projects");
+  assert.equal(after.disabled, false);
+  console.log("P9 cleared:", JSON.stringify(expanded(scene)));
+});
+
+test("D3 switching to a project expands it even after it was folded by hand, and the project left behind follows its own rule", async (t) => {
+  const scene = await startNavigation(t, saved);
+  await waitFor(() => assert.equal(projectOrder(scene).length, 3));
+  await click(control(scene.history(), "button", "Collapse all projects"));
+  const go = async (from, name, folder) => {
+    const card = await scene.menu(from);
+    const search = control(card, "searchbox", "Search or open a project…");
+    await input(search, name);
+    await waitFor(() => assert.equal(accessibleName(roles(card, "menuitem")[0]), name));
+    await keyDown(search, "Enter");
+    await waitFor(async () => assert.equal(await scene.currentFolder(), folder));
+  };
+  await go("navigation-project", "empty-project", P.empty);
+  console.log("D3 after first switch", JSON.stringify(expanded(scene)));
+  await go("empty-project", "navigation-project", P.project);
+  console.log("D3", JSON.stringify(expanded(scene)));
+  assert.deepEqual(expanded(scene), { "Default space": "false", "navigation-project": "true", "empty-project": "false" });
+});
+
+test("D5 Switch project… in the composer workspace menu opens the project switcher card", async (t) => {
+  const scene = await startNavigation(t, saved);
+  await waitFor(() => assert.equal(projectOrder(scene).length, 3));
+  await click(control(scene.navigation(), "button", "Hide sidebar"));
+  await waitFor(() => control(scene.navigation(), "button", "Show sidebar"));
+  await click(await waitFor(() => control(scene.container, "button", "Workspace: navigation-project, branch main")));
+  await click(await waitFor(() => control(scene.container, "button", "Switch project…")));
+  const card = await waitFor(() => control(dom.window.document.body, "menu", "navigation-project"));
+  await scene.settled();
+  const search = control(card, "searchbox", "Search or open a project…");
+  console.log("D5 focus in search:", dom.window.document.activeElement === search);
+  assert.equal(dom.window.document.activeElement, search);
+});
